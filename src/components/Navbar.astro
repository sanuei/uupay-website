---
import { languages, useTranslations } from '../i18n/ui';

interface Props {
  lang: keyof typeof languages;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'en' ? '' : `/${lang}`;

// 语言英文名 (支持输入英文/中文实时搜索过滤)
const langEnName: Record<string, string> = {
  en: 'English',
  'zh-CN': 'Simplified Chinese 简体中文',
  'zh-TW': 'Traditional Chinese 繁體中文',
  ja: 'Japanese 日本語',
  ko: 'Korean 한국어',
  vi: 'Vietnamese Tiếng Việt',
  th: 'Thai ไทย',
  ms: 'Malay Bahasa Melayu',
  id: 'Indonesian Bahasa Indonesia',
  es: 'Spanish Español',
  ar: 'Arabic العربية'
};
---

<header class="navbar">
  <div class="container">
    <a href={`${base}/`} class="nav-logo">
      <img src="/images/logo-wordmark-v2.webp" alt="UUPAY" class="nav-logo-img" width="1012" height="209" />
    </a>

    <ul class="nav-menu">
      <li><a href="#products" class="nav-link">{t('nav.products')}</a></li>
      <li><a href="#cards" class="nav-link">{t('nav.cards')}</a></li>
      <li><a href={`${base}/partners`} class="nav-link">{t('nav.partners')}</a></li>
      <li><a href={`${base}/promotions`} class="nav-link">{t('nav.promotions')}</a></li>
      <li><a href={`${base}/announcements`} class="nav-link">{t('nav.announcements')}</a></li>
    </ul>

    <div class="nav-actions">
      <!-- 注册 (主 CTA) -->
      <a href="https://uupay.com/zh-cn/register?invitationCode=VJAIIG" class="btn btn-primary nav-action-cta">{t('nav.register')}</a>

      <!-- 下载 App 按钮 (OKX 图标按钮) -->
      <a href="#download" class="nav-download-btn" aria-label={t('nav.download')} title={t('nav.download')}>
        <svg class="nav-download-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 3V14M12 14L7 9M12 14L17 9M4 19H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- 语言切换器 (参考 OKX 极简风格: 放大地球 icon, 无文字, OKX 风格白底弹窗) -->
      <div class="lang-selector" id="lang-selector">
        <button class="lang-trigger" aria-label="Select language" aria-haspopup="true">
          <svg class="lang-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
            <path d="M3.6 12H20.4M12 3C14.25 5.5 15.75 8.5 15.75 12C15.75 15.5 14.25 18.5 12 21M12 3C9.75 5.5 8.25 8.5 8.25 12C8.25 15.5 9.75 18.5 12 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>

        <!-- 参考图 2 样式白底弹窗 -->
        <div class="lang-dropdown" role="menu" aria-label="Languages">
          <div class="lang-dropdown-top">
            <span class="lang-dropdown-title">语言</span>
            <svg class="lang-info-icon" viewBox="0 0 16 16" fill="none" width="14" height="14">
              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M8 7.5V11M8 5.2H8.01" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>

          <!-- 搜索框 -->
          <div class="lang-search-box">
            <svg class="lang-search-icon" viewBox="0 0 16 16" fill="none" width="14" height="14">
              <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.4"/>
              <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <input type="text" class="lang-search-input" id="lang-search-input" placeholder="搜索" autocomplete="off" />
          </div>

          <div class="lang-group-label">全球</div>

          <div class="lang-options-list">
            {Object.entries(languages).map(([code, name]) => (
              <a
                href={code === 'en' ? '/' : `/${code}/`}
                class={`lang-option ${code === lang ? 'active' : ''}`}
                role="menuitem"
                data-lang={code}
                data-search={`${name} ${langEnName[code] || ''} ${code}`.toLowerCase()}
              >
                <span class="lang-option-name">{name}</span>
                {code === lang && (
                  <svg class="lang-check" viewBox="0 0 16 16" fill="none" aria-hidden="true" width="16" height="16">
                    <path d="M3.5 8L6.5 11L12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- 移动端菜单开关 -->
    <button class="nav-burger" id="nav-burger" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- 移动端下拉菜单面板 -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul class="mobile-menu-list">
      <li><a href="#products" class="mobile-menu-link">{t('nav.products')}</a></li>
      <li><a href="#cards" class="mobile-menu-link">{t('nav.cards')}</a></li>
      <li><a href={`${base}/partners`} class="mobile-menu-link">{t('nav.partners')}</a></li>
      <li><a href={`${base}/promotions`} class="mobile-menu-link">{t('nav.promotions')}</a></li>
      <li><a href={`${base}/announcements`} class="mobile-menu-link">{t('nav.announcements')}</a></li>
    </ul>
    <div class="mobile-menu-actions">
      <a href="https://uupay.com/zh-cn/register?invitationCode=VJAIIG" class="btn btn-primary btn-large mobile-menu-cta">{t('nav.register')}</a>
    </div>
  </div>
</header>

<script>
  const burger = document.getElementById('nav-burger');
  const mobileMenu = document.getElementById('mobile-menu');

  if (burger && mobileMenu) {
    const closeMenu = () => {
      burger.classList.remove('is-active');
      burger.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.remove('is-open');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('nav-open');
    };

    burger.addEventListener('click', () => {
      const willOpen = !mobileMenu.classList.contains('is-open');
      burger.classList.toggle('is-active', willOpen);
      burger.setAttribute('aria-expanded', String(willOpen));
      mobileMenu.classList.toggle('is-open', willOpen);
      mobileMenu.setAttribute('aria-hidden', String(!willOpen));
      document.documentElement.classList.toggle('nav-open', willOpen);
    });

    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    window.addEventListener('resize', () => {
      if (window.innerWidth > 968) closeMenu();
    });
  }

  // 语言搜索过滤与滚动隔离保护
  const searchInput = document.getElementById('lang-search-input') as HTMLInputElement | null;
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      const options = document.querySelectorAll('.lang-option');
      options.forEach((opt) => {
        const searchText = opt.getAttribute('data-search') || '';
        if (searchText.includes(query)) {
          (opt as HTMLElement).style.display = 'flex';
        } else {
          (opt as HTMLElement).style.display = 'none';
        }
      });
    });
  }

  // 拦截内部滚动, 防止全页触发滑动手势穿透
  const langList = document.querySelector('.lang-options-list');
  if (langList) {
    langList.addEventListener('wheel', (e) => {
      const event = e as WheelEvent;
      const scrollTop = langList.scrollTop;
      const scrollHeight = langList.scrollHeight;
      const height = langList.clientHeight;
      const delta = event.deltaY;

      // 如果向上滚到底或向下滚到底, 阻止事件传播给 window 触发整页滑动
      if (delta > 0 && scrollTop + height >= scrollHeight - 1) {
        e.preventDefault();
      } else if (delta < 0 && scrollTop <= 0) {
        e.preventDefault();
      }
      e.stopPropagation();
    }, { passive: false });
  }
</script>
