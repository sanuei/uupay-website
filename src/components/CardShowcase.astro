---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

// 两张卡: 尊享金色实体卡 + 极简白色虚拟卡, 横向切换
const cards = [
  {
    key: 'physical',
    img: '/images/20260729-134437.png',
    alt: 'UUPAY Gold Physical Card',
    w: 1280, h: 807,
    title: t('cardShowcase.physical_title'),
    desc: t('cardShowcase.physical_desc'),
  },
  {
    key: 'virtual',
    img: '/images/20260729-134429.png',
    alt: 'UUPAY White Virtual Card',
    w: 1579, h: 996,
    title: t('cardShowcase.virtual_title'),
    desc: t('cardShowcase.virtual_desc'),
  },
];
---

<section id="cards" class="card-switch section-lift">
  <div class="container">
    <div class="section-head--split scroll-reveal">
      <h2 set:html={t('cardShowcase.title_html')} />
      <p>{t('cardShowcase.subtitle')}</p>
    </div>

    <div class="card-switch-stage scroll-reveal">
      <!-- 上一张 -->
      <button class="card-nav card-nav-prev" aria-label="Previous card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <!-- 轮播视口 -->
      <div class="card-switch-viewport" id="card-switch-viewport">
        <div class="card-switch-track" id="card-switch-track">
          {cards.map((card, i) => (
            <div class={`card-slide ${i === 0 ? 'is-active' : ''}`} data-idx={i}>
              <div class="card-visual">
                <div class="card-tilt">
                  <img src={card.img} alt={card.alt} width="900" height="567" loading="lazy" decoding="async" />
                  <span class="card-glare" aria-hidden="true"></span>
                </div>
              </div>
              <div class="card-detail">
                <span class="card-detail-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{card.title}</h3>
                <p>{card.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 下一张 -->
      <button class="card-nav card-nav-next" aria-label="Next card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <!-- 圆点指示器 -->
    <div class="card-switch-dots" id="card-switch-dots" role="tablist">
      {cards.map((_, i) => (
        <button class={`card-dot ${i === 0 ? 'is-active' : ''}`} data-idx={i} role="tab" aria-label={`Card ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('card-switch-track');
  const viewport = document.getElementById('card-switch-viewport');
  const dotsWrap = document.getElementById('card-switch-dots');

  if (track && viewport && dotsWrap) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.card-slide'));
    const realCount = slides.length; // 实际 2 张卡

    // 1. 克隆第一张卡片并追加到末尾，实现单向无限向左推进
    const firstClone = slides[0].cloneNode(true) as HTMLElement;
    firstClone.classList.remove('is-active');
    firstClone.setAttribute('data-clone', 'true');
    track.appendChild(firstClone);

    const allSlides = Array.from(track.querySelectorAll<HTMLElement>('.card-slide'));
    const dots = Array.from(dotsWrap.querySelectorAll<HTMLElement>('.card-dot'));
    const prevBtn = document.querySelector<HTMLElement>('.card-nav-prev');
    const nextBtn = document.querySelector<HTMLElement>('.card-nav-next');

    let index = 0;
    let autoPlayTimer: any = null;
    let isTransitioning = false;

    // 渲染指定位置 (withTransition 控制是否启用平滑过度)
    const render = (withTransition = true) => {
      if (!withTransition) {
        track.style.transition = 'none';
      } else {
        track.style.transition = 'transform 0.65s cubic-bezier(0.16, 1, 0.3, 1)';
      }

      track.style.transform = `translateX(${-index * 100}%)`;

      // 映射高亮的 realIndex (0 或 1)
      const realIndex = index % realCount;
      allSlides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === realIndex);
        d.setAttribute('aria-selected', String(i === realIndex));
      });
    };

    // 动画结束监听: 当滑到克隆节点 (index 2) 时，瞬间无感重置到 index 0
    track.addEventListener('transitionend', () => {
      isTransitioning = false;
      if (index >= realCount) {
        index = 0;
        render(false); // 关闭动画无感知复位
      }
    });

    // 始终向一个方向（单向向左）推进
    const next = () => {
      if (isTransitioning) return;
      isTransitioning = true;
      index++;
      render(true);
    };

    const prev = () => {
      if (isTransitioning) return;
      isTransitioning = true;
      if (index === 0) {
        index = realCount;
        render(false);
        void track.offsetHeight; // 强制 reflow 重绘
      }
      index--;
      render(true);
    };

    const goTo = (targetRealIdx: number) => {
      if (isTransitioning) return;
      isTransitioning = true;
      index = targetRealIdx;
      render(true);
    };

    // 4 秒单向自动轮播控制器
    const startAutoPlay = () => {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        next();
      }, 4000);
    };

    const stopAutoPlay = () => {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    };

    // 交互绑定 (手动点击后重置计时)
    dots.forEach((d) => d.addEventListener('click', () => {
      goTo(Number(d.dataset.idx));
      startAutoPlay();
    }));
    prevBtn?.addEventListener('click', () => {
      prev();
      startAutoPlay();
    });
    nextBtn?.addEventListener('click', () => {
      next();
      startAutoPlay();
    });

    // 鼠标悬停 / 触屏接触时暂停轮播，移开后恢复
    viewport.addEventListener('mouseenter', stopAutoPlay);
    viewport.addEventListener('mouseleave', startAutoPlay);
    viewport.addEventListener('touchstart', stopAutoPlay, { passive: true });
    viewport.addEventListener('touchend', startAutoPlay, { passive: true });

    // 键盘左右切换
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { prev(); startAutoPlay(); }
      if (e.key === 'ArrowRight') { next(); startAutoPlay(); }
    });

    // 触屏 swipe
    let startX = 0;
    let startY = 0;
    let tracking = false;
    viewport.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      tracking = true;
    }, { passive: true });
    viewport.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) {
        if (dx < 0) next();
        else prev();
        startAutoPlay();
      }
    }, { passive: true });

    // 启动初始渲染与单向自动轮播
    render(false);
    startAutoPlay();

    // 3D 交互倾斜 + 光泽跟随 (仅悬停型指针设备; 触屏/reduced-motion 不启用)
    if (matchMedia('(hover: hover) and (pointer: fine)').matches
        && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLElement>('.card-tilt').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          const nx = (e.clientX - r.left) / r.width - 0.5;   // -0.5 ~ 0.5
          const ny = (e.clientY - r.top) / r.height - 0.5;
          el.classList.add('is-tilting');
          el.style.setProperty('--ty', `${(nx * 12).toFixed(2)}deg`);
          el.style.setProperty('--tx', `${(-ny * 9).toFixed(2)}deg`);
          el.style.setProperty('--gx', `${((nx + 0.5) * 100).toFixed(1)}%`);
          el.style.setProperty('--gy', `${((ny + 0.5) * 100).toFixed(1)}%`);
        });
        el.addEventListener('pointerleave', () => {
          el.classList.remove('is-tilting');
          el.style.setProperty('--ty', '0deg');
          el.style.setProperty('--tx', '0deg');
        });
      });
    }
  }
</script>
